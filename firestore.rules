rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }
    function validJournal() {
      let entry = request.resource.data;
      return entry.keys().hasOnly(['title', 'content', 'mood', 'createdAt', 'updatedAt'])
        && entry.title is string && entry.title.size() <= 200
        && entry.content is string && entry.content.size() <= 20000
        && (entry.title.size() > 0 || entry.content.size() > 0)
        && entry.mood is string && entry.mood.size() <= 40
        && entry.createdAt is timestamp && entry.updatedAt is timestamp;
    }
    match /users/{uid} {
      allow read, write: if owner(uid);
      match /journalEntries/{entryId} {
        allow read, delete: if owner(uid);
        allow create: if owner(uid) && validJournal()
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if owner(uid) && validJournal()
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt == request.time;
      }
      match /aiConversations/{conversationId} {
        allow read, write: if owner(uid);
        match /messages/{messageId} { allow read, write: if owner(uid); }
      }
      match /reasonsToStay/{reasonId} {
        allow read, delete: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      }
    }
  }
}
